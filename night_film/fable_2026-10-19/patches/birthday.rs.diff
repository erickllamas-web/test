+/// The index of the sample at which local sidereal time has advanced one full
+/// turn from the first sample — the last frame of a star-closed loop. The LST
+/// column wraps at 360°, so the advance is accumulated step by step. A track
+/// shorter than a sidereal day returns its last index.
+pub fn sidereal_last(lst: &[f64]) -> usize {
+    let n = lst.len();
+    if n < 2 { return n.saturating_sub(1); }
+    let (mut adv, mut best, mut best_d) = (0.0f64, n - 1, f64::MAX);
+    for i in 1..n {
+        adv += (lst[i] - lst[i - 1]).rem_euclid(360.0);
+        let d = (adv - 360.0).abs();
+        if d < best_d { best_d = d; best = i; }
+        if adv > 360.0 + 180.0 { break; }
+    }
+    if adv < 360.0 - 1.0 && best_d > 1.0 { return n - 1; }   // never got round
+    best
+}
